<!DOCTYPE html>
<html>
  <head>
  <title>Media library</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%# Link each real stylesheet explicitly. application.css is a Sprockets
        manifest (require_tree) that does NOT bundle under Propshaft — the default
        pipeline in modern Rails — so referencing it alone leaves the layout
        unstyled. Listing layout.css + picker.css works under both pipelines. %>
    <%= stylesheet_link_tag "venus_media_library/layout", "venus_media_library/picker", media: "all" %>
    <%= javascript_include_tag "venus_media_library/venus_media_library", defer: true %>

  <%= yield :head %>
</head>
<body class="ml-body">

<%# Full-page management workspace: a 30% left-nav column beside a 70% content
    column. This layout is used only for full-page requests; the picker modal
    renders with `layout: false`, so it stays lean and keeps its horizontal tabs. %>
<div class="ml-layout">
  <aside class="ml-layout__nav">
    <%= render "venus_media_library/shared/sidebar" %>
  </aside>
  <main class="ml-layout__content">
    <%= yield %>
  </main>
</div>

</body>
</html>
