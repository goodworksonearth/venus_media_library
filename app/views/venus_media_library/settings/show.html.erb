<div class="ml-library">
  <header class="ml-library__header">
    <h1>Media Library Settings</h1>
    <p class="ml-library__count">Administrator overview</p>
  </header>

  <%= render "venus_media_library/shared/tabs", active_tab: :settings %>

  <p class="ml-settings__intro">These values are read from the host application's <code>VenusMediaLibrary.configure</code> block. Change them in the host initializer; this screen does not store credentials or modify runtime access rules.</p>

  <section class="ml-settings__section" aria-labelledby="ml-settings-assets">
    <h2 id="ml-settings-assets">Assets by view</h2>
    <dl class="ml-settings__list">
      <dt>Library uploads</dt><dd><%= @tab_counts[:library] %></dd>
      <dt>Community shared</dt><dd><%= @tab_counts[:community] %></dd>
      <dt>Static assets</dt><dd><%= @tab_counts[:static] %></dd>
      <dt>Cloud assets</dt><dd><%= @tab_counts[:cloud] %></dd>
    </dl>
  </section>

  <section class="ml-settings__section" aria-labelledby="ml-settings-uploads">
    <h2 id="ml-settings-uploads">Upload policy</h2>
    <dl class="ml-settings__list">
      <dt>Maximum file size</dt><dd><%= number_to_human_size(@max_file_size) %> (<%= @max_file_size %> bytes)</dd>
      <dt>Storage service</dt><dd><%= @storage_service %></dd>
      <dt>Allowed content types</dt>
      <dd>
        <% if @allowed_content_types.empty? %>
          None configured
        <% else %>
          <ul class="ml-settings__types">
            <% @allowed_content_types.each do |content_type| %>
              <li><code><%= content_type %></code></li>
            <% end %>
          </ul>
        <% end %>
      </dd>
    </dl>
  </section>

  <section class="ml-settings__section" aria-labelledby="ml-settings-visibility">
    <h2 id="ml-settings-visibility">Visibility</h2>
    <p>Uploads are private to their owner by default. Owners may explicitly share an upload with the community. Administrators can review tenant-scoped uploads and import legacy uploads, but host <code>asset_scope</code> rules still apply.</p>
  </section>
</div>
