<div class="ml-library">
  <header class="ml-library__header">
    <h1>Community Assets</h1>
    <p class="ml-library__count"><%= @total_count %> image<%= "s" unless @total_count == 1 %></p>
  </header>

  <%= render "venus_media_library/shared/tabs", active_tab: :community %>

  <% if @images.empty? %>
    <p class="ml-empty">No community assets have been shared yet.</p>
  <% else %>
    <div class="ml-grid" data-ml-grid>
      <%= render partial: "venus_media_library/images/image", collection: @images, as: :image %>
    </div>
  <% end %>

  <nav class="ml-pagination">
    <% if @page > 1 %>
      <%= link_to "← Newer", community_assets_path(page: @page - 1), class: "ml-btn" %>
    <% end %>
    <% if @has_more %>
      <%= link_to "Older →", community_assets_path(page: @page + 1), class: "ml-btn" %>
    <% end %>
  </nav>
</div>
