<%# Full-page left navigation for the media library management workspace.
    Rendered ONLY by the engine layout (application.html.erb) — i.e. the /media
    full-page context. The picker modal renders with `layout: false` and keeps
    its own lean horizontal category tabs (pickers/_tabs), so this sidebar never
    appears there. Entries and role-gating come from `venus_media_library_nav_items`;
    the active section from `venus_media_library_active_nav`, both derived from
    the current controller so views don't pass an explicit local.

    Management seam: the header and the <nav> are separate blocks so future
    workspace chrome (global search / filter, bulk-action controls) can slot in
    beside the nav without touching individual category views. %>
<nav class="ml-nav" aria-label="Media library sections">
  <div class="ml-nav__brand">Media Library</div>

  <ul class="ml-nav__list">
    <% venus_media_library_nav_items.each do |item| %>
      <li class="ml-nav__item">
        <%= link_to item[:label], item[:path],
              class: "ml-nav__link",
              aria: { current: venus_media_library_active_nav == item[:key] ? "page" : nil } %>
      </li>
    <% end %>
  </ul>
</nav>
